{
  "expo": {
    "name": "Forge",
    "slug": "forge-workout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "forge",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.forgeapp.workout",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.forgeapp.workout",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111111"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-camera",
        { "cameraPermission": "Allow Forge to access your camera to scan barcodes and take food photos." }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Forge to access your photos for AI food analysis.",
          "cameraPermission": "Allow Forge to take photos for AI food analysis."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#111111"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
